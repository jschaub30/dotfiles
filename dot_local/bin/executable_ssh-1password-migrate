#!/usr/bin/env bash
# Move SSH private keys out of ~/.ssh and into 1Password.
#
#   ssh-1password-migrate             show which keys the 1Password agent already serves
#   ssh-1password-migrate --finalize  for those keys: point ~/.ssh/config.d/* at the .pub
#                                     file and move the private key out of ~/.ssh
#
# Import each key in the 1Password app first:
#   New Item → SSH Key → Add Private Key → Import a Key File
set -euo pipefail

case "$(uname)" in
  Darwin) sock="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock" ;;
  *)      sock="$HOME/.1password/agent.sock" ;;
esac
if [[ ! -S $sock ]]; then
  echo "1Password SSH agent isn't running. Turn it on in 1Password → Settings → Developer → Use the SSH agent." >&2
  exit 1
fi

finalize=false
[[ ${1:-} == --finalize ]] && finalize=true

agent_fps=$(SSH_AUTH_SOCK=$sock ssh-add -l 2>/dev/null | awk '{print $2}' || true)
retired="$HOME/.ssh/retired-private-keys"
pending=0

for key in "$HOME"/.ssh/*; do
  [[ -f $key ]] && head -1 "$key" | grep -q 'PRIVATE KEY' || continue
  name=${key##*/}
  pub="$key.pub"
  # Needs the passphrase if the key has one.
  [[ -f $pub ]] || ssh-keygen -y -f "$key" > "$pub"
  fp=$(ssh-keygen -lf "$pub" | awk '{print $2}')

  if ! grep -qxF "$fp" <<<"$agent_fps"; then
    echo "✗ $name  not in 1Password yet"
    pending=$((pending + 1))
    continue
  fi

  if ! $finalize; then
    echo "✓ $name  in 1Password"
    continue
  fi

  name_re=${name//./\\.}
  for cfg in "$HOME"/.ssh/config.d/*; do
    [[ -f $cfg ]] || continue
    sed -E "s#^([[:space:]]*IdentityFile[[:space:]]+[^[:space:]]*/)${name_re}[[:space:]]*\$#\1${name}.pub#" "$cfg" > "$cfg.tmp"
    mv "$cfg.tmp" "$cfg"
  done
  mkdir -p "$retired" && chmod 700 "$retired"
  mv "$key" "$retired/"
  echo "✓ $name  now served by 1Password; private key moved to $retired/"
done

if $finalize && [[ -d $retired ]]; then
  echo
  echo "Test your ssh hosts, then delete $retired."
elif ! $finalize && ((pending == 0)); then
  echo
  echo "All keys are in 1Password. Run again with --finalize."
fi
