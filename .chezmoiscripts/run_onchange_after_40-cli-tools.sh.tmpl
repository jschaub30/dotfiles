#!/usr/bin/env bash
# Tools with their own installers. Most land in ~/.local/bin and update themselves.
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"

# npm comes from Homebrew's node.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
else
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

{{- if .work }}
command -v aka >/dev/null || npm install -g akkeris
{{- end }}

command -v claude >/dev/null || curl -fsSL https://claude.ai/install.sh | bash
{{- if .work }}
command -v twg >/dev/null ||
  bash <(curl -fsSL https://teamwork-graph.atlassian.com/cli/install) --yes --skip-login --skip-skills
# odp: uv (from Homebrew) puts it in ~/.local/bin. Its uv package is
# named `cli`, so update with `uv tool upgrade cli`.
command -v odp >/dev/null ||
  uv tool install "git+https://github.com/octanner/odp-app-catalog.git#subdirectory=cli"
{{- end }}
{{- if ne .chezmoi.os "darwin" }}
# `gh copilot` runs whichever copilot binary is on PATH; on macOS it's a brew cask.
command -v copilot >/dev/null || curl -fsSL https://gh.io/copilot-install | bash

# gcloud (a brew cask on macOS): Google's tarball into ~/google-cloud-sdk, where the
# oh-my-zsh gcloud plugin finds it. Update with `gcloud components update`.
if [[ ! -x "$HOME/google-cloud-sdk/bin/gcloud" ]]; then
  case "$(uname -m)" in
    x86_64) gcloud_arch=x86_64 ;;
    aarch64 | arm64) gcloud_arch=arm ;;
    *) echo "gcloud: unsupported arch $(uname -m)" >&2; exit 1 ;;
  esac
  curl -fsSL "https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-linux-${gcloud_arch}.tar.gz" |
    tar -xz -C "$HOME"
  "$HOME/google-cloud-sdk/install.sh" --quiet --usage-reporting=false \
    --path-update=false --command-completion=false
fi

# Headless Chromium for rasterizing HTML/SVG figures to PNG (on macOS, Google
# Chrome does this). Browsers land in ~/.cache/ms-playwright; bump the version
# here to update.
# (1.48 hangs extracting Chromium under Node 26.) `playwright install` is a
# no-op once the browser is fully installed.
playwright_version=1.64.1
[[ "$(playwright --version 2>/dev/null)" == "Version $playwright_version" ]] ||
  npm install -g "playwright@$playwright_version"
playwright install chromium
# Chromium's shared libraries and fonts, which a server image lacks.
if command -v apt-get >/dev/null; then
  sudo env "PATH=$PATH" playwright install-deps chromium
fi
{{- end }}
