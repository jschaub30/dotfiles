#!/usr/bin/env bash
# Re-runs whenever the package list below changes.
set -euo pipefail

if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
else
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

{{- if .work }}
# Brew refuses to load formulae from untrusted taps.
brew tap redpanda-data/tap
brew trust redpanda-data/tap
brew tap rundeck/rundeck-cli
brew trust rundeck/rundeck-cli
brew tap hashicorp/tap
brew trust hashicorp/tap
{{- end }}

brew bundle --file=- <<'BREWFILE'
{{- if .work }}
tap "redpanda-data/tap"
tap "rundeck/rundeck-cli"
tap "hashicorp/tap"
brew "cx"
brew "redpanda-data/tap/redpanda"
brew "glab"
# rd needs Java but its formula doesn't declare it; ~/.zshrc puts openjdk@17 on PATH.
brew "openjdk@17"
brew "rundeck/rundeck-cli/rundeck-cli"
brew "postgresql@17"
brew "hashicorp/tap/vault"
{{- end }}
brew "awscli"
brew "chezmoi"
brew "fd"
brew "fzf"
brew "gh"
brew "git"
brew "gum"
brew "jq"
brew "kubectx"
brew "kubernetes-cli"
brew "mise"
brew "neovim"
brew "node"
brew "ripgrep"
brew "starship"
brew "tree"
brew "uv"
brew "zsh-autosuggestions"
{{- if eq .chezmoi.os "darwin" }}
cask "1password"
cask "1password-cli"
cask "copilot-cli"
cask "gcloud-cli"
{{- if .work }}
cask "docker-desktop"
{{- end }}
cask "font-hack-nerd-font"
{{- end }}
BREWFILE
