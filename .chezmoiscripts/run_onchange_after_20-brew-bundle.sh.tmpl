#!/usr/bin/env bash
# Re-runs whenever the package list below changes.
set -euo pipefail

if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
else
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

brew bundle --file=- <<'BREWFILE'
brew "awscli"
brew "chezmoi"
brew "fd"
brew "fzf"
brew "gh"
brew "git"
brew "jq"
brew "kubectx"
brew "kubernetes-cli"
brew "mise"
brew "neovim"
brew "node"
brew "ripgrep"
brew "starship"
brew "tree"
brew "uv"
brew "zsh-autosuggestions"
{{- if eq .chezmoi.os "darwin" }}
cask "1password"
cask "1password-cli"
cask "copilot-cli"
cask "gcloud-cli"
cask "font-hack-nerd-font"
{{- end }}
BREWFILE
