#!/usr/bin/env bash
# Install Homebrew (on Linux, first the packages it needs, plus zsh).
set -euo pipefail

{{ if eq .chezmoi.os "linux" -}}
if command -v apt-get >/dev/null; then
  sudo apt-get update
  sudo apt-get install -y build-essential procps curl file git zsh unzip gnupg
elif command -v dnf >/dev/null; then
  sudo dnf install -y gcc gcc-c++ make procps-ng curl file git zsh unzip gnupg2
else
  echo "Unsupported distro: install curl, git, zsh and a compiler, then re-run chezmoi apply." >&2
  exit 1
fi
{{- end }}

if [[ ! -x /opt/homebrew/bin/brew && ! -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

{{ if eq .chezmoi.os "linux" -}}
if [[ $(getent passwd "$USER" | cut -d: -f7) != */zsh ]]; then
  echo "Making zsh your login shell (may ask for your password)"
  chsh -s "$(command -v zsh)" || echo "chsh failed; run: chsh -s $(command -v zsh)" >&2
fi
{{- end }}
