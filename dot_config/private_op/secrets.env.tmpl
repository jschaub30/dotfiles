# Secret references, loaded into the shell on demand by `opsecrets` (see ~/.zshrc).
# Format: NAME=op://vault/item/field — the values stay in 1Password.
VAULT_TOKEN=op://{{ .opVault }}/Vault Token/credential
ODP_PASSWORD=op://{{ .opVault }}/ODP Admin/password
AKKERIS_USERNAME=op://{{ .opVault }}/Akkeris/username
AKKERIS_PASSWORD=op://{{ .opVault }}/Akkeris/password
ATLASSIAN_API_TOKEN=op://{{ .opVault }}/Atlassian API Token/credential
