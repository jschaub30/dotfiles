# Managed by chezmoi. Per-host entries (work servers, etc.) live in ~/.ssh/config.d/
# and are not tracked. Point IdentityFile at a key's *.pub file: the private half
# stays in 1Password and the agent signs with it.

# Lets a config.d file copied from a Mac parse here; UseKeychain is macOS-only.
IgnoreUnknown UseKeychain

# The agent is set here, before the Include, because ssh keeps the first value it
# reads. A Host * block in a config.d file copied from another machine can't then
# point this one at an agent socket that doesn't exist.
{{- if not .opAgent }}
IdentityAgent SSH_AUTH_SOCK
{{- else if eq .chezmoi.os "darwin" }}
IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- else }}
IdentityAgent ~/.1password/agent.sock
{{- end }}

Include ~/.ssh/config.d/*

Host github.com
  IdentityFile ~/.ssh/id_ed25519.pub
  IdentitiesOnly yes
